{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/core/workout-engine.ts",
    "src/core/timer.ts",
    "src/core/plan-validator.ts",
    "src/core/persistence.ts",
    "src/core/plan-transformations.ts"
