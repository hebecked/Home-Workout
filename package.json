{
  "name": "home-workout-pwa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "deploy:cloudflare": "wrangler pages deploy dist --project-name home-workout",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "mutation": "stryker run",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "1.62.1",
    "@stryker-mutator/core": "^9.1.0",
    "@stryker-mutator/vitest-runner": "^9.1.0",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.35.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^8.0.0",
    "vitest": "4.1.11",
    "wrangler": "^4.127.1"
  }
}
