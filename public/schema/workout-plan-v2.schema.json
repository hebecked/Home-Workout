{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-workout-65g.pages.dev/schema/workout-plan-v2.schema.json",
  "title": "Home Workout plan schema v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "languages", "name", "displayLanguages", "phases"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "$ref": "#/$defs/safeText" },
    "languages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["code", "label"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
          "label": { "$ref": "#/$defs/safeText" }
        }
      }
    },
    "name": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/safeText" } },
    "displayLanguages": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "type": "string" } },
    "phases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/phase" } },
    "translationMetadata": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["sourceLanguage", "origin", "reviewStatus", "provider", "translatedAt"],
        "properties": {
          "sourceLanguage": { "type": "string" },
          "origin": { "const": "machine" },
          "reviewStatus": { "enum": ["needs-review", "reviewed"] },
          "provider": { "$ref": "#/$defs/safeText" },
          "translatedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "$defs": {
    "safeText": { "type": "string", "minLength": 1, "pattern": "^[^<>]+$" },
    "phase": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "rounds", "restBetweenExercises", "restBetweenRounds", "restAfterPhase", "exercises"],
      "properties": {
        "id": { "$ref": "#/$defs/safeText" },
        "kind": { "enum": ["warm-up", "training", "active-recovery", "cool-down"] },
        "rounds": { "type": "integer", "minimum": 1 },
        "restBetweenExercises": { "type": "number", "minimum": 0 },
        "restBetweenRounds": { "type": "number", "minimum": 0 },
        "restAfterPhase": { "type": "number", "minimum": 0 },
        "exercises": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/exercise" } }
      }
    },
    "exercise": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "exerciseId", "type", "target", "translations", "alternativeExerciseIds"],
      "properties": {
        "id": { "$ref": "#/$defs/safeText" },
        "exerciseId": { "$ref": "#/$defs/safeText" },
        "type": { "enum": ["repetitions", "duration", "untimed"] },
        "target": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false, "required": ["min", "max", "unit"],
              "properties": {
                "min": { "type": "number", "exclusiveMinimum": 0 },
                "max": { "type": "number", "exclusiveMinimum": 0 },
                "unit": { "enum": ["repetitions", "per-side"] }
              }
            },
            {
              "type": "object", "additionalProperties": false, "required": ["seconds"],
              "properties": { "seconds": { "type": "number", "exclusiveMinimum": 0 } }
            },
            { "type": "object", "maxProperties": 0 }
          ]
        },
        "translations": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "required": ["name", "instructions"],
            "properties": {
              "name": { "$ref": "#/$defs/safeText" },
              "instructions": { "$ref": "#/$defs/safeText" }
            }
          }
        },
        "alternativeExerciseIds": { "type": "array", "items": { "$ref": "#/$defs/safeText" } }
      }
    }
  }
}
